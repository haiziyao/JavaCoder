package com.jcoder.ui.web;

/**
 * 单文件前端页面（内嵌 HTML/CSS/JS）。
 * 采用 DeepSeek 官网亮色主题风格。
 * 保持与后端解耦，通过 /api/* 交互。
 *
 * 作者：亥子曜
 * -后之览者，亦将有感于斯文
 */
public final class WebPage {

    private WebPage() {
    }

    public static String html() {
        return """
        <!DOCTYPE html>
        <html lang="zh-CN">
        <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>MyCoder · AI 编程助手</title>
        <style>
        :root {
          --brand: #4D6BFE;
          --brand-strong: #3453db;
          --brand-soft: #eef2ff;
          --bg: #f7f8fa;
          --surface: #ffffff;
          --surface-2: #f2f4f7;
          --border: #e5e7eb;
          --border-strong: #d1d5db;
          --text: #1f2937;
          --text-dim: #6b7280;
          --text-weak: #9ca3af;
          --user-bubble: #4D6BFE;
          --user-text: #ffffff;
          --tool-bg: #f9fafb;
          --error: #dc2626;
          --ok: #16a34a;
          --shadow: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
          --shadow-lg: 0 10px 30px rgba(0,0,0,.10);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }
        body {
          background: var(--bg);
          color: var(--text);
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
          display: flex;
          overflow: hidden;
          -webkit-font-smoothing: antialiased;
        }
        a { color: var(--brand); text-decoration: none; }

        /* ============ 左侧边栏 ============ */
        .sidebar {
          width: 264px;
          min-width: 264px;
          background: var(--surface);
          border-right: 1px solid var(--border);
          display: flex;
          flex-direction: column;
        }
        .brand {
          padding: 18px 20px;
          display: flex;
          align-items: center;
          gap: 10px;
          border-bottom: 1px solid var(--border);
        }
        .brand-logo {
          width: 32px; height: 32px;
          border-radius: 9px;
          background: linear-gradient(135deg, #4D6BFE, #7b93ff);
          display: grid; place-items: center;
          color: #fff; font-weight: 800; font-size: 15px;
          box-shadow: 0 4px 10px rgba(77,107,254,.25);
        }
        .brand-name { font-size: 16px; font-weight: 700; letter-spacing: -.01em; }
        .new-chat {
          margin: 14px;
          padding: 11px;
          background: var(--brand);
          color: #fff;
          border: none;
          border-radius: 10px;
          cursor: pointer;
          font-size: 14px;
          font-weight: 600;
          transition: background .18s;
          display: flex; align-items: center; justify-content: center; gap: 6px;
        }
        .new-chat:hover { background: var(--brand-strong); }
        .sidebar-section {
          padding: 0 14px 14px;
          font-size: 12px;
          color: var(--text-dim);
          flex: 1; overflow-y: auto;
        }
        .sidebar-section .label {
          font-size: 11px; font-weight: 600; letter-spacing: .05em;
          text-transform: uppercase; color: var(--text-weak);
          margin: 12px 2px 8px;
        }
        .cfg-row {
          display: flex; justify-content: space-between; align-items: center;
          padding: 7px 2px; border-bottom: 1px solid var(--border);
        }
        .cfg-row:last-child { border-bottom: none; }
        .cfg-row .k { color: var(--text-dim); }
        .cfg-row .v { color: var(--text); font-weight: 500; max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cfg-select {
          width: 100%; margin-top: 4px; padding: 8px 10px;
          background: var(--surface-2); color: var(--text);
          border: 1px solid var(--border); border-radius: 8px; font-size: 13px;
        }
        .cfg-select:focus { outline: none; border-color: var(--brand); }
        .tag-list { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 4px; }
        .tag {
          font-size: 11px; padding: 2px 8px; border-radius: 6px;
          background: var(--brand-soft); color: var(--brand-strong); font-weight: 500;
        }

        /* ============ 主区域 ============ */
        .main {
          flex: 1; display: flex; flex-direction: column; min-width: 0;
        }
        .header {
          padding: 14px 24px;
          border-bottom: 1px solid var(--border);
          background: var(--surface);
          display: flex; align-items: center; gap: 12px;
          font-size: 13px; color: var(--text-dim);
        }
        .mode-badge {
          padding: 4px 12px; border-radius: 999px;
          background: var(--brand-soft); color: var(--brand-strong);
          font-weight: 600; font-size: 12px; cursor: pointer; user-select: none;
          border: 1px solid transparent; transition: .18s; position: relative;
        }
        .mode-badge:hover { border-color: var(--brand); }
        .header .title { font-weight: 600; color: var(--text); }
        .header .spacer { flex: 1; }
        .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }
        .status-dot.busy { background: #f59e0b; animation: pulse 1.2s infinite; }
        @keyframes pulse { 50% { opacity: .4; } }

        /* ============ 对话区 ============ */
        .chat {
          flex: 1; overflow-y: auto; padding: 28px 24px;
          scroll-behavior: smooth;
        }
        .chat-inner { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px; }

        .msg { display: flex; flex-direction: column; }
        .msg .meta {
          display: flex; align-items: center; gap: 8px;
          font-size: 12px; color: var(--text-weak); margin-bottom: 7px;
        }
        .msg .avatar {
          width: 24px; height: 24px; border-radius: 7px;
          display: grid; place-items: center; font-size: 12px; font-weight: 700;
        }
        .msg.user .avatar { background: var(--brand); color: #fff; }
        .msg.assistant .avatar { background: var(--brand-soft); color: var(--brand-strong); }
        .msg.tool .avatar { background: var(--surface-2); color: var(--text-dim); }

        .content { line-height: 1.7; font-size: 15px; }

        .msg.user { align-items: flex-end; }
        .msg.user .content {
          background: var(--user-bubble); color: var(--user-text);
          padding: 11px 16px; border-radius: 16px 16px 4px 16px;
          max-width: 86%; white-space: pre-wrap; word-break: break-word;
        }
        .msg.assistant .content { white-space: pre-wrap; word-break: break-word; }
        .msg.tool .content {
          background: var(--tool-bg); border: 1px solid var(--border);
          border-left: 3px solid #8b97b0;
          border-radius: 8px; padding: 12px 14px;
          font-family: ui-monospace, "SFMono-Regular", "Cascadia Code", Consolas, monospace;
          font-size: 12.5px; white-space: pre-wrap; word-break: break-word;
          color: #3a4356;
        }
        .msg.tool .content.error { border-color: #fecaca; border-left-color: #dc2626; background: #fef2f2; color: #b91c1c; }
        .content code {
          font-family: ui-monospace, "SFMono-Regular", "Cascadia Code", Consolas, monospace; font-size: .88em;
          background: var(--surface-2); padding: 1px 6px; border-radius: 5px;
          color: #3453db;
        }
        /* 克制的 VS Code 风格代码块（assistant 回复中的 fenced code） */
        .msg.assistant pre {
          background: #1e1e1e; color: #d4d4d4;
          border: 1px solid #2a2a2a; border-radius: 8px;
          padding: 14px 16px; margin: 10px 0;
          font-family: ui-monospace, "SFMono-Regular", "Cascadia Code", Consolas, monospace;
          font-size: 13px; line-height: 1.6;
          white-space: pre-wrap; word-break: break-word;
          overflow-x: auto;
        }
        .msg.assistant pre code {
          background: transparent; padding: 0; color: inherit; font-size: inherit; border-radius: 0;
        }
        /* 文件路径等行内等宽代码的克制样式 */
        .msg.assistant p > code, .msg.assistant li > code, .msg.assistant .content:not(pre) code {
          background: #f1f4f8; border: 1px solid #e0e4ea;
        }
        .tool-label {
          display: inline-block; font-size: 11px; font-weight: 700;
          padding: 2px 8px; border-radius: 4px; margin-bottom: 8px;
          background: #eceff5; color: #4a5568;
          text-transform: uppercase; letter-spacing: .04em;
          font-family: ui-monospace, "SFMono-Regular", "Cascadia Code", Consolas, monospace;
        }
        .tool-label.error { background: #fee2e2; color: #b91c1c; }
        .tool-label.ok { background: #dcfce7; color: #15803d; }

        /* 打字动画 */
        .typing { display: inline-flex; gap: 5px; align-items: center; padding: 6px 0; }
        .typing span {
          width: 7px; height: 7px; border-radius: 50%; background: var(--text-weak);
          animation: blink 1.2s infinite;
        }
        .typing span:nth-child(2) { animation-delay: .2s; }
        .typing span:nth-child(3) { animation-delay: .4s; }
        @keyframes blink { 0%,100% { opacity: .2; } 50% { opacity: 1; } }

        /* ============ 底部输入 ============ */
        .composer {
          padding: 16px 24px 20px; background: var(--surface);
          border-top: 1px solid var(--border);
        }
        .composer-inner {
          max-width: 760px; margin: 0 auto;
          display: flex; gap: 10px; align-items: flex-end;
          background: var(--surface); border: 1px solid var(--border-strong);
          border-radius: 14px; padding: 8px; transition: .18s;
          box-shadow: var(--shadow);
        }
        .composer-inner:focus-within { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(77,107,254,.12); }
        .composer textarea {
          flex: 1; resize: none; border: none; outline: none;
          min-height: 40px; max-height: 200px; padding: 8px 6px;
          font-size: 15px; line-height: 1.5; font-family: inherit;
          background: transparent; color: var(--text);
        }
        .send-btn {
          padding: 10px 18px; background: var(--brand); color: #fff;
          border: none; border-radius: 10px; cursor: pointer;
          font-size: 14px; font-weight: 600; height: 42px;
          display: flex; align-items: center; gap: 6px; transition: .18s;
        }
        .send-btn:hover:not(:disabled) { background: var(--brand-strong); }
        .send-btn:disabled { background: var(--surface-2); color: var(--text-weak); cursor: not-allowed; }

        /* ============ 底部面板（Prompt / JSON / 历史） ============ */
        .panel {
          border-top: 1px solid var(--border); background: var(--surface);
          max-height: 240px; overflow-y: auto; font-size: 12px;
        }
        .panel .tabs {
          display: flex; gap: 4px; padding: 8px 24px;
          border-bottom: 1px solid var(--border);
          position: sticky; top: 0; background: var(--surface); z-index: 1;
        }
        .panel .tabs button {
          background: transparent; border: none; color: var(--text-dim);
          cursor: pointer; padding: 6px 14px; border-radius: 8px; font-size: 12.5px; font-weight: 500;
        }
        .panel .tabs button:hover { background: var(--surface-2); }
        .panel .tabs button.active { background: var(--brand-soft); color: var(--brand-strong); font-weight: 600; }
        .panel pre {
          margin: 0; padding: 16px 24px;
          white-space: pre-wrap; word-break: break-word;
          font-family: ui-monospace, "Cascadia Code", monospace;
          line-height: 1.6; color: var(--text);
        }
        .hidden { display: none !important; }

        @media (max-width: 768px) {
          .sidebar { display: none; }
        }
        </style>
        </head>
        <body>

        <aside class="sidebar">
          <div class="brand">
            <div class="brand-logo">M</div>
            <span class="brand-name">MyCoder</span>
          </div>
          <button class="new-chat" onclick="resetSession()">＋ 新建会话</button>
          <div class="sidebar-section">
            <div class="label">会话信息</div>
            <div class="cfg-row"><span class="k">工作目录</span><span class="v" id="workdir">-</span></div>
            <div class="cfg-row"><span class="k">模式</span><span class="v" id="mode-text">NORMAL</span></div>
            <div class="label">Agent 模式</div>
            <select class="cfg-select" id="mode-select" onchange="setMode(this.value)">
              <option value="NORMAL">NORMAL · 常规</option>
              <option value="PLAN">PLAN · 规划</option>
              <option value="EXECUTE_PLAN">EXECUTE_PLAN · 执行计划</option>
            </select>
            <div class="label">可用工具</div>
            <div class="tag-list" id="tool-list"></div>
          </div>
        </aside>

        <div class="main">
          <div class="header">
            <span class="status-dot" id="status-dot"></span>
            <span class="title">会话</span>
            <span class="mode-badge" id="mode-badge" title="点击切换模式" onclick="cycleMode()">NORMAL</span>
            <span class="spacer"></span>
            <span id="status">就绪</span>
          </div>

          <div class="chat" id="chat">
            <div class="chat-inner" id="chat-inner"></div>
          </div>

          <div class="panel">
            <div class="tabs">
              <button id="tab-prompt" class="active" onclick="switchPanel('prompt')">System Prompt</button>
              <button id="tab-json" onclick="switchPanel('json')">请求 JSON</button>
              <button id="tab-history" onclick="switchPanel('history')">历史</button>
            </div>
            <pre id="panel-prompt"></pre>
            <pre id="panel-json" class="hidden"></pre>
            <pre id="panel-history" class="hidden"></pre>
          </div>

          <div class="composer">
            <div class="composer-inner">
              <textarea id="input" rows="1" placeholder="给 MyCoder 发送指令…… (Enter 发送，Shift+Enter 换行)"></textarea>
              <button class="send-btn" id="send-btn" onclick="sendMessage()">发送</button>
            </div>
          </div>
        </div>

        <script>
        let running = false;
        let currentAssistantEl = null;
        let currentAssistantBuf = '';
        let currentEs = null;

        function $(id) { return document.getElementById(id); }

        function el(tag, cls, text) {
          const n = document.createElement(tag);
          if (cls) n.className = cls;
          if (text !== undefined) n.textContent = text;
          return n;
        }

        function scrollDown() {
          const c = $('chat');
          c.scrollTop = c.scrollHeight;
        }

        function setStatus(text, busy) {
          $('status').textContent = text;
          $('status-dot').classList.toggle('busy', !!busy);
        }

        function addMessage(role, content, isError) {
          const wrap = el('div', 'msg ' + role);
          const meta = el('div', 'meta');
          const avatar = el('div', 'avatar', role === 'user' ? '你' : (role === 'assistant' ? 'AI' : '§'));
          const roleName = el('span', '', role === 'user' ? '你' : (role === 'assistant' ? 'MyCoder' : '工具'));
          meta.appendChild(avatar);
          meta.appendChild(roleName);
          const body = el('div', 'content');
          if (isError) body.classList.add('error');
          body.textContent = content;
          wrap.appendChild(meta);
          wrap.appendChild(body);
          $('chat-inner').appendChild(wrap);
          scrollDown();
          return body;
        }

        function ensureAssistant() {
          const wrap = el('div', 'msg assistant');
          const meta = el('div', 'meta');
          const avatar = el('div', 'avatar', 'AI');
          const roleName = el('span', '', 'MyCoder');
          meta.appendChild(avatar);
          meta.appendChild(roleName);
          const body = el('div', 'content');
          const typing = el('div', 'typing');
          typing.innerHTML = '<span></span><span></span><span></span>';
          body.appendChild(typing);
          wrap.appendChild(meta);
          wrap.appendChild(body);
          $('chat-inner').appendChild(wrap);
          scrollDown();
          return { wrap, body };
        }

        function addToolMessage(title, text, isError) {
          const wrap = el('div', 'msg tool');
          const meta = el('div', 'meta');
          const avatar = el('div', 'avatar', '§');
          const roleName = el('span', '', '工具');
          meta.appendChild(avatar);
          meta.appendChild(roleName);
          const body = el('div', 'content');
          if (isError) body.classList.add('error');
          const label = el('div', 'tool-label' + (isError ? ' error' : ''), title);
          const txt = el('div', '', text);
          body.appendChild(label);
          body.appendChild(txt);
          wrap.appendChild(meta);
          wrap.appendChild(body);
          $('chat-inner').appendChild(wrap);
          scrollDown();
          return body;
        }

        async function sendMessage() {
          const input = $('input');
          const text = input.value.trim();
          if (!text || running) return;
          input.value = '';
          autoResize(input);
          running = true;
          $('send-btn').disabled = true;
          setStatus('运行中…', true);

          addMessage('user', text);
          const { body } = ensureAssistant();
          currentAssistantEl = body;
          currentAssistantBuf = '';

          const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text })
          });
          if (!res.ok) {
            finishRun();
            addToolMessage('错误', '提交失败: HTTP ' + res.status, true);
            return;
          }
          const chatResp = await res.json();
          const runId = chatResp.runId;
          if (!runId) {
            finishRun();
            addToolMessage('错误', '后端未返回 runId', true);
            return;
          }

          openEventStream(runId);
        }

        function openEventStream(runId) {
          currentEs = new EventSource('/api/event?runId=' + runId);
          currentEs.onmessage = function (ev) {
            let data;
            try { data = JSON.parse(ev.data); } catch (e) { return; }
            handleEvent(data);
          };
          currentEs.addEventListener('done', function () {
            if (currentEs) currentEs.close();
            currentEs = null;
            finishRun();
          });
          currentEs.onerror = function () {
            if (currentEs) currentEs.close();
            currentEs = null;
            finishRun();
          };
        }

        function handleEvent(data) {
          switch (data.type) {
            case 'text':
              if (!currentAssistantEl) {
                const created = ensureAssistant();
                currentAssistantEl = created.body;
                currentAssistantBuf = '';
              }
              const typing = currentAssistantEl.querySelector('.typing');
              if (typing) typing.remove();
              currentAssistantBuf += (data.delta || '');
              currentAssistantEl.innerHTML = renderMarkdown(currentAssistantBuf);
              scrollDown();
              break;
            case 'tool_call':
              addToolMessage('调用工具 · ' + data.name, formatArgs(data.args));
              currentAssistantEl = null;
              break;
            case 'tool_result':
              addToolMessage('工具结果' + (data.error === 'true' ? ' · 失败' : ''), truncate(data.output, 2000), data.error === 'true');
              break;
            case 'turn_complete':
              setStatus('第 ' + data.turn + ' 轮完成', true);
              break;
            case 'log':
              break;
            case 'error':
              addToolMessage('错误', data.message, true);
              break;
            case 'loop_complete':
              break;
          }
        }

        function formatArgs(args) {
          if (args == null || args === '') return '';
          // 后端已序列化为 JSON 字符串，直接美化展示即可。
          let obj = args;
          if (typeof args === 'string') {
            try { obj = JSON.parse(args); } catch (e) { return args; }
          }
          try { return JSON.stringify(obj, null, 2); } catch (e) { return String(obj); }
        }

        function truncate(s, n) {
          if (!s) return '';
          s = String(s);
          return s.length > n ? s.slice(0, n) + '\\n…(截断)' : s;
        }

        function escapeHtml(s) {
          return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }

        // 轻量 Markdown 渲染：仅处理 fenced code block（```）与行内 code（`）。
        function renderInline(s) {
          return escapeHtml(s).replace(/`([^`]+)`/g, function (m, c) {
            return '<code>' + escapeHtml(c) + '</code>';
          });
        }

        function renderMarkdown(src) {
          const lines = String(src).split('\\n');
          let html = '';
          let inFence = false;
          let fenceLang = '';
          let codeBuf = [];
          let i = 0;
          while (i < lines.length) {
            const line = lines[i];
            if (!inFence) {
              const m = line.trim().match(/^```(.*)$/);
              if (m) {
                inFence = true;
                fenceLang = m[1].trim();
                codeBuf = [];
                i++;
                continue;
              }
              html += renderInline(line) + '<br>';
            } else {
              if (line.trim() === '```') {
                const langAttr = fenceLang ? ' data-lang="' + escapeHtml(fenceLang) + '"' : '';
                html += '<pre' + langAttr + '><code>' + escapeHtml(codeBuf.join('\\n')) + '</code></pre>';
                inFence = false;
              } else {
                codeBuf.push(line);
              }
            }
            i++;
          }
          if (inFence) {
            html += '<pre><code>' + escapeHtml(codeBuf.join('\\n')) + '</code></pre>';
          }
          return html;
        }

        function finishRun() {
          running = false;
          $('send-btn').disabled = false;
          setStatus('就绪', false);
          currentAssistantEl = null;
          currentAssistantBuf = '';
          refreshState();
        }

        async function refreshState() {
          try {
            const res = await fetch('/api/state');
            const state = await res.json();
            $('workdir').textContent = state.workDir || '-';
            $('mode-badge').textContent = state.mode;
            $('mode-text').textContent = state.mode;
            $('mode-select').value = state.mode;
            $('panel-prompt').textContent = state.systemPrompt || '(空)';
            $('panel-json').textContent = state.lastRequestJson || '(暂无请求 JSON)';

            const tools = state.tools || [];
            const tagList = $('tool-list');
            tagList.innerHTML = '';
            tools.forEach(function (t) {
              const tag = el('span', 'tag', t.name);
              tag.title = t.description || '';
              tagList.appendChild(tag);
            });
            if (tools.length === 0) {
              tagList.appendChild(el('span', 'tag', '(无)'));
            }

            const hist = (state.history || []).map(function (m) {
              const c = m.content || '';
              const extra = m.toolCalls ? ' [toolCalls]' : (m.toolResults ? ' [toolResults]' : '');
              return '[' + m.role + ']' + extra + ': ' + c.slice(0, 200) + (c.length > 200 ? '…' : '');
            }).join('\\n\\n');
            $('panel-history').textContent = hist || '(暂无历史)';
          } catch (e) {
            // 忽略
          }
        }

        async function setMode(mode) {
          try {
            await fetch('/api/mode', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ mode: mode })
            });
            $('mode-badge').textContent = mode;
            $('mode-text').textContent = mode;
          } catch (e) {}
        }

        async function cycleMode() {
          const modes = ['NORMAL', 'PLAN', 'EXECUTE_PLAN'];
          const cur = $('mode-badge').textContent;
          const idx = modes.indexOf(cur);
          const next = modes[(idx + 1) % modes.length];
          await setMode(next);
        }

        async function resetSession() {
          try {
            await fetch('/api/reset', { method: 'POST' });
            $('chat-inner').innerHTML = '';
            addMessage('assistant', '会话已重置。输入指令开始。');
            $('panel-history').textContent = '';
          } catch (e) {}
        }

        function switchPanel(name) {
          ['prompt', 'json', 'history'].forEach(function (n) {
            $('tab-' + n).classList.toggle('active', n === name);
            $('panel-' + n).classList.toggle('hidden', n !== name);
          });
        }

        function autoResize(el) {
          el.style.height = 'auto';
          el.style.height = Math.min(el.scrollHeight, 200) + 'px';
        }

        $('input').addEventListener('keydown', function (e) {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
          }
        });
        $('input').addEventListener('input', function (e) { autoResize(e.target); });

        // 初始加载
        refreshState();
        addMessage('assistant', '你好，我是 MyCoder。可以让我读取文件、执行命令、修改代码。底部面板可查看 System Prompt 与请求 JSON 快照。');
        </script>
        </body>
        </html>
        """;
    }
}
